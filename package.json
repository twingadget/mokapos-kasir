{
    "name": "moka-pos-bar",
    "private": true,
    "type": "module",
    "scripts": {
        "clean:next": "node -e \"const fs=require('fs'); for (const d of ['.next','.next-dev']) { if (fs.existsSync(d)) fs.rmSync(d,{recursive:true,force:true}); }\"",
        "dev": "npm run clean:next && next dev",
        "dev:clean": "npm run clean:next && next dev",
        "build": "next build",
        "build:clean": "npm run clean:next && next build",
        "build:with-prisma": "prisma generate && next build",
        "start": "next start",
        "typecheck": "tsc --noEmit",
        "db:up": "docker compose up -d postgres",
        "db:down": "docker compose down",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev --skip-generate",
        "prisma:seed": "prisma db seed"
    },
    "dependencies": {
        "@prisma/client": "^6.4.1",
        "bcryptjs": "^2.4.3",
        "next": "^15.2.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.11",
        "@types/bcryptjs": "^2.4.6",
        "@types/node": "^22.13.4",
        "@types/react": "^19.0.10",
        "@types/react-dom": "^19.0.4",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.5.3",
        "prisma": "^6.4.1",
        "tailwindcss": "^3.4.17",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3"
    }
}
