generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    admin
    kasir
    waiter
    manager
}

enum OrderStatus {
    PAID
    OPEN_BILL
    WAITING
    VOID
}

model User {
    id              Int       @id @default(autoincrement())
    name            String
    email           String    @unique
    emailVerifiedAt DateTime? @map("email_verified_at")
    password        String
    role            Role      @default(kasir)
    rememberToken   String?   @map("remember_token")
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")

    orders   Order[] @relation("OrderCashier")
    waitedOn Order[] @relation("OrderWaiter")

    @@map("users")
    @@index([role])
}

model Category {
    id       Int       @id @default(autoincrement())
    name     String    @unique
    isActive Boolean   @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    products Product[]

    @@map("categories")
}

model Product {
    id         Int      @id @default(autoincrement())
    categoryId Int      @map("category_id")
    name       String
    sku        String   @unique
    price      Decimal  @db.Decimal(12, 2)
    costPrice  Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
    isActive   Boolean  @default(true) @map("is_active")
    trackStock Boolean  @default(false) @map("track_stock")
    stockQty   Int      @default(0) @map("stock_qty")
    imagePath  String?  @map("image_path")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    category  Category         @relation(fields: [categoryId], references: [id], onUpdate: Cascade, onDelete: Restrict)
    variants  ProductVariant[]
    orderItems OrderItem[]

    @@map("products")
    @@index([name])
    @@index([categoryId, isActive])
}

model ProductVariant {
    id         Int      @id @default(autoincrement())
    productId  Int      @map("product_id")
    name       String
    price      Decimal? @db.Decimal(12, 2)
    priceDelta Decimal? @map("price_delta") @db.Decimal(12, 2)
    isActive   Boolean  @default(true) @map("is_active")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    product   Product   @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Cascade)
    orderItems OrderItem[]

    @@map("product_variants")
    @@index([productId, isActive])
}

model Addon {
    id       Int      @id @default(autoincrement())
    name     String
    price    Decimal  @db.Decimal(12, 2)
    isActive Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    orderItemAddons OrderItemAddon[]

    @@map("addons")
    @@index([name, isActive])
}

model PaymentMethod {
    id       Int      @id @default(autoincrement())
    name     String
    code     String   @unique
    isActive Boolean  @default(true) @map("is_active")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("payment_methods")
    @@index([isActive, name])
}

model InvoiceCounter {
    id         Int      @id @default(autoincrement())
    date       DateTime @db.Date @unique
    lastNumber Int      @default(0) @map("last_number")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    @@map("invoice_counters")
}

model Order {
    id            Int         @id @default(autoincrement())
    invoiceNo     String      @unique @map("invoice_no")
    userId        Int         @map("user_id")
    waiterId      Int?        @map("waiter_id")
    status        OrderStatus @default(PAID)
    subtotal      Decimal     @db.Decimal(12, 2)
    discountType  String      @default("none") @map("discount_type")
    discountValue Decimal     @default(0) @map("discount_value") @db.Decimal(12, 2)
    tax           Decimal     @default(0) @db.Decimal(12, 2)
    service       Decimal     @default(0) @db.Decimal(12, 2)
    total         Decimal     @db.Decimal(12, 2)
    paymentMethod String      @map("payment_method")
    cashReceived  Decimal?    @map("cash_received") @db.Decimal(12, 2)
    change        Decimal?    @db.Decimal(12, 2)
    notes         String?
    orderedAt     DateTime    @map("ordered_at")
    createdAt     DateTime    @default(now()) @map("created_at")
    updatedAt     DateTime    @updatedAt @map("updated_at")

    user   User  @relation("OrderCashier", fields: [userId], references: [id], onUpdate: Cascade, onDelete: Restrict)
    waiter User? @relation("OrderWaiter", fields: [waiterId], references: [id], onUpdate: Cascade, onDelete: SetNull)
    items  OrderItem[]

    @@map("orders")
    @@index([status])
    @@index([userId, orderedAt])
    @@index([waiterId, orderedAt])
    @@index([paymentMethod, orderedAt])
    @@index([orderedAt])
}

model OrderItem {
    id            Int      @id @default(autoincrement())
    orderId       Int      @map("order_id")
    productId     Int      @map("product_id")
    variantId     Int?     @map("variant_id")
    nameSnapshot  String   @map("name_snapshot")
    price         Decimal  @db.Decimal(12, 2)
    costPrice     Decimal  @default(0) @map("cost_price") @db.Decimal(12, 2)
    qty           Int
    lineTotal     Decimal  @map("line_total") @db.Decimal(12, 2)
    lineCostTotal Decimal  @default(0) @map("line_cost_total") @db.Decimal(12, 2)
    notes         String?
    createdAt     DateTime @default(now()) @map("created_at")
    updatedAt     DateTime @updatedAt @map("updated_at")

    order      Order          @relation(fields: [orderId], references: [id], onUpdate: Cascade, onDelete: Cascade)
    product    Product        @relation(fields: [productId], references: [id], onUpdate: Cascade, onDelete: Restrict)
    variant    ProductVariant? @relation(fields: [variantId], references: [id], onUpdate: Cascade, onDelete: SetNull)
    addons     OrderItemAddon[]

    @@map("order_items")
    @@index([orderId, productId])
}

model OrderItemAddon {
    id           Int      @id @default(autoincrement())
    orderItemId  Int      @map("order_item_id")
    addonId      Int      @map("addon_id")
    nameSnapshot String   @map("name_snapshot")
    price        Decimal  @db.Decimal(12, 2)
    createdAt    DateTime @default(now()) @map("created_at")
    updatedAt    DateTime @updatedAt @map("updated_at")

    orderItem OrderItem @relation(fields: [orderItemId], references: [id], onUpdate: Cascade, onDelete: Cascade)
    addon     Addon     @relation(fields: [addonId], references: [id], onUpdate: Cascade, onDelete: Restrict)

    @@map("order_item_addons")
    @@index([orderItemId, addonId])
}
